SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=*

# Neon Postgres connection string (from Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/gateguard?sslmode=require

# Cloudinary (from Cloudinary dashboard -> API keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS/CSRF
# For local development only:
CORS_ALLOW_ALL_ORIGINS=True
# For production set CORS_ALLOW_ALL_ORIGINS=False and provide comma-separated origins.
# Example: https://your-frontend.onrender.com,https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=
# Optional regex patterns for dynamic subdomains.
# Example: ^https://.*\.onrender\.com$
CORS_ALLOWED_ORIGIN_REGEXES=
# If you use cookie auth/session across origins.
CORS_ALLOW_CREDENTIALS=True
# Trusted origins for CSRF-protected endpoints (like Django admin login).
CSRF_TRUSTED_ORIGINS=
